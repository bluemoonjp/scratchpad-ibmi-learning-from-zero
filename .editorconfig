root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# RPG III / RPG IV(固定形式)/ CL / DDS は桁位置が意味を持つ。
# 行末の空白除去やインデント正規化が列をずらす可能性があるため無効化する。
[*.{rpg,rpgle,clp,clle,pf,lf,dspf,prtf,cmd,rpgleinc,bnd}]
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset
