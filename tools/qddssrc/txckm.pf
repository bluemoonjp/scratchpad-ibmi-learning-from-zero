     A*                                     TXCKM - manifest for TXCHECK.
     A*                                     1 row = 1 object check.
     A          R TXCKMR                    TEXT('TXCHECK manifest')
     A            LESSON         6A         TEXT('Lesson id, e.g. 04-13')
     A            SEQNBR         3S 0       TEXT('Order within lesson')
     A            OBJNAME       10A         TEXT('Object name to check')
     A            OBJTYPE       10A         TEXT('*PGM/*FILE/*DTAARA etc')
     A            OBJATTR       10A         TEXT('Expect attr, blank=skip')
     A            CKDESC        50A         TEXT('Shown in PASS/FAIL msg')
     A          K LESSON
     A          K SEQNBR
     A                                      UNIQUE
